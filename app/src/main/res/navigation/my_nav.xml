<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/my_nav"
    app:startDestination="@id/splashScreen">
    <fragment
        android:id="@+id/splashScreen"
        android:name="md.attendance.sl.ui.SplashScreen"
        android:label="fragment_login"
        tools:layout="@layout/fragment_splash_screen">

    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="md.attendance.sl.ui.login.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />
    </fragment>
    <fragment
        android:id="@+id/signUpFragment"
        android:name="md.attendance.sl.ui.sign_up.SignUpFragment"
        android:label="fragment_home_screen"
        tools:layout="@layout/fragment_sign_up">
        <action
            android:id="@+id/action_signUpFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="md.attendance.sl.ui.home.HomeScreen"
        android:label="fragment_home_screen"
        tools:layout="@layout/fragment_home_screen">
        <action
            android:id="@+id/action_homeFragment_to_attendanceHistory"
            app:destination="@id/attendanceHistory" />
        <action
            android:id="@+id/action_homeFragment_to_profile"
            app:destination="@id/profile" />
        <action
            android:id="@+id/action_homeFragment_to_mapScreen"
            app:destination="@id/mapScreen" />
    </fragment>

    <fragment
        android:id="@+id/attendanceHistory"
        android:name="md.attendance.sl.ui.history.AttendanceHistory"
        android:label="fragment_home_screen"
        tools:layout="@layout/fragment_attendance_history">
        <action
            android:id="@+id/action_attendanceHistory_to_editHistory"
            app:destination="@id/editHistory" />
    </fragment>

    <fragment
        android:id="@+id/editHistory"
        android:name="md.attendance.sl.ui.history.EditHistory"
        android:label="fragment_home_screen"
        tools:layout="@layout/fragment_edit_history">
        <argument
            android:name="history"
            app:argType="md.attendance.sl.data.history.HistoryEntity" />
    </fragment>
    <fragment
        android:id="@+id/profile"
        android:name="md.attendance.sl.ui.profile.ProfileFragment"
        android:label="fragment_profile_screen"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_editProfile"
            app:destination="@id/editProfile" />
    </fragment>
    <fragment
        android:id="@+id/editProfile"
        android:name="md.attendance.sl.ui.profile.EditProfile"
        android:label="fragment_edit_profile_screen"
        tools:layout="@layout/fragment_edit_profile">
        <argument
            android:name="user"
            app:argType="md.attendance.sl.data.users.UserEntity" />
    </fragment>

    <fragment
        android:id="@+id/mapScreen"
        android:name="md.attendance.sl.MapsFragment"
        android:label="fragment_map_screen"
        tools:layout="@layout/fragment_maps">

    </fragment>
</navigation>